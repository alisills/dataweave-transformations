	<flow name="058-group-ordersFlow" doc:id="e27b8eea-aa93-47cc-b014-569c6157b572" >
		<http:listener doc:name="GET /group-orders" doc:id="659f9a34-243e-48f3-9aab-b641569899bc" config-ref="HTTP_Listener_config" path="/group-orders" allowedMethods="GET"/>
		<!-- [STUDIO:"Return customerId => orders."]<set-payload value="#[payload&#93;" doc:name="Return customerId =&gt; orders." doc:id="140bc320-6623-4d4e-a733-4e79d3eb1a11" /> [STUDIO] -->
		<set-payload value='#[[{"id":"O1","customerId":"C1","total":50},{"id":"O2","customerId":"C2","total":120},{"id":"O3","customerId":"C1","total":75},{"id":"O4","customerId":"C9","total":20}]]' doc:name='[{"id":"O1","customerId":"C1","total":50},{"id":"O2","customerId":"C2","total":120},{"id":"O3","customerId":"C1","total":75},{"id":"O4","customerId":"C9","total":20}]' doc:id="4018be41-2e9f-4c5f-88a2-e4499b431fc3" />
		<ee:transform doc:name="((payload groupBy (item) -&gt; item.customerId) pluck (v, k) -&gt; {&#10;    groupName: k,&#10;    records: v,&#10;    totalCount: sizeOf(v)&#10;}) maxBy (item) -&gt; item.totalCount" doc:id="94bac0a9-2d22-474a-9717-66e547283638" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
((payload groupBy (item) -> item.customerId) pluck (v, k) -> {
    groupName: k,
    records: v,
    totalCount: sizeOf(v)
}) maxBy (item) -> item.totalCount]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
