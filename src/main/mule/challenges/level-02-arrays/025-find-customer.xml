<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="025-find-customerFlow" doc:id="ad9deca7-b669-42ec-8c54-8ca5dd9767b2" >
		<http:listener doc:name="Listener" doc:id="12d1edf2-a44e-4121-b787-97f46cf08935" config-ref="HTTP_Listener_config" allowedMethods="GET" path="find-customer"/>
		<!-- [STUDIO:"Return the customer whose id equals a target value.."]<set-payload value="#[payload&#93;" doc:name="Return the customer whose id equals a target value.." doc:id="f174f2bc-e5f9-46e9-bfd1-8a38d38dc7a7" /> [STUDIO] -->
		<set-payload value='#[[{"id":"C1","name":"Ali","age":17,"email":"ali@example.com"},{"id":"C2","name":"Omar","age":18,"email":"omar@example.com"},{"id":"C3","name":"Zara","age":35,"email":"zara@example.com"}]]' doc:name='[{"id":"C1","name":"Ali","age":17,"email":"ali@example.com"},{"id":"C2","name":"Omar","age":18,"email":"omar@example.com"},{"id":"C3","name":"Zara","age":35,"email":"zara@example.com"}]' doc:id="5c25c462-4cd8-4acf-9e90-164909a75ce8" />
		<ee:transform doc:name='(payload map (v, k) -&gt; {&#10;	"id": v.id,&#10;	"name": v.name,&#10;	"age": v.age,&#10;	"email": v.email&#10;}) filter ($.id == "C2")' doc:id="cc332d68-ff3a-40da-a4e6-662697998083" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload map (v, k) -> {
	"id": v.id,
	"name": v.name,
	"age": v.age,
	"email": v.email
}) filter ($.id == "C2") ]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
