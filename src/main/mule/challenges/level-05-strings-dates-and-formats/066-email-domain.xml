		<ee:transform doc:name='{&#10;    email: (payload.email splitBy "@")[1]&#10;}' doc:id="0dc54718-1abe-4a92-be2c-1cf5493e558b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
