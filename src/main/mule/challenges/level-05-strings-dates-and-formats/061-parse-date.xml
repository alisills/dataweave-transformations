	<flow name="061-parse-dateFlow" doc:id="4a435964-6a37-45ad-83da-51ca2b7d560a" >
		<http:listener doc:name="Listener" doc:id="377ed7ae-021a-4d47-9045-5c21f3d23222" config-ref="HTTP_Listener_config" path="parse-date"/>
		<!-- [STUDIO:"Convert MM/dd/yyyy to yyyy-MM-dd."]<set-payload value="#[payload&#93;" doc:name="Convert MM/dd/yyyy to yyyy-MM-dd." doc:id="929fe9d8-505f-4544-94c4-b38284d98e34" /> [STUDIO] -->
