		<ee:transform doc:name='{&#10;    date: payload.date as Date {format: "dd/MM/yyyy"} as String {format: "yyyy-MM-dd"}&#10;}' doc:id="587ae10e-74ab-48c3-9d45-c4e9b83505f7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
