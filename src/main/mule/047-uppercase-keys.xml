		<ee:transform doc:name="payload mapObject (value, key, index) -&gt; {&#10;    (upper(key)): value&#10;}" doc:id="5ac30e3b-dfb1-46ac-bcaa-03a4188f2778" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload mapObject (value, key, index) -> {
    (upper(key)): value
}]]></ee:set-payload>
