	<flow name="047-uppercase-keysFlow" doc:id="2d30a578-737b-42cc-868e-625fcb60b224" >
		<http:listener doc:name="Listener" doc:id="86a006ad-ccc4-4a9a-963c-fef07066a539" config-ref="HTTP_Listener_config" path="uppercase-keys"/>
		<!-- [STUDIO:"Convert every object key to uppercase."]<set-payload value="#[payload&#93;" doc:name="Convert every object key to uppercase." doc:id="77772c60-907d-403f-991e-ecfab39cfb6c" /> [STUDIO] -->
